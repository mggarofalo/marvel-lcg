<Project Sdk="Godot.NET.Sdk/4.7.0">

  <!-- The desktop presentation assembly. Godot is allowed here and nowhere
       below this point; Directory.Build.targets enforces both sides. -->
  <PropertyGroup>
    <RootNamespace>Marvel.Godot</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <MarvelMayReferenceGodot>true</MarvelMayReferenceGodot>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Godot implements the presentation layer. Transport-neutral decision
       composition and visible projections live in their own projects. -->
  <ItemGroup>
    <ProjectReference Include="../Marvel.Client/Marvel.Client.csproj" />
    <ProjectReference Include="../Marvel.Decisions/Marvel.Decisions.csproj" />
    <ProjectReference Include="../Marvel.Server/Marvel.Server.csproj" />
    <ProjectReference Include="../Marvel.View/Marvel.View.csproj" />
  </ItemGroup>

</Project>
