<Project Sdk="Godot.NET.Sdk/4.7.1">

  <!-- The desktop presentation assembly. Godot is allowed here and nowhere
       in the shared presentation or engine projects. -->
  <PropertyGroup>
    <RootNamespace>Marvel.Godot</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <MarvelMayReferenceGodot>true</MarvelMayReferenceGodot>
    <!-- Godot embeds the server host in-process. Publishing an executable
         ProjectReference would also collect its apphost and runtime files,
         which collide when Godot publishes both macOS architectures. -->
    <MarvelServerOutputType>Library</MarvelServerOutputType>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Godot implements the presentation layer. Transport-neutral decision
       composition and visible projections live in their own projects. -->
  <ItemGroup>
    <ProjectReference Include="../Marvel.Client/Marvel.Client.csproj"
                      AdditionalProperties="MarvelServerOutputType=Library" />
    <ProjectReference Include="../Marvel.Decisions/Marvel.Decisions.csproj" />
    <ProjectReference Include="../Marvel.Rules/Marvel.Rules.csproj" />
    <ProjectReference Include="../Marvel.Server/Marvel.Server.csproj"
                      AdditionalProperties="MarvelServerOutputType=Library" />
    <ProjectReference Include="../Marvel.View/Marvel.View.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Marvel.Godot.Tests" />
  </ItemGroup>

</Project>
