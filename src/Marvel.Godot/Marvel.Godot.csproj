<Project Sdk="Godot.NET.Sdk/4.7.1">

  <!-- The desktop presentation assembly. Godot is allowed here and nowhere
       in the shared presentation or engine projects. -->
  <PropertyGroup>
    <RootNamespace>Marvel.Godot</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <MarvelMayReferenceGodot>true</MarvelMayReferenceGodot>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Godot implements the presentation layer. Transport-neutral decision
       composition and visible projections live in their own projects. -->
  <ItemGroup>
    <ProjectReference Include="../Marvel.Client/Marvel.Client.csproj" />
    <ProjectReference Include="../Marvel.Decisions/Marvel.Decisions.csproj" />
    <ProjectReference Include="../Marvel.Rules/Marvel.Rules.csproj" />
    <ProjectReference Include="../Marvel.Server/Marvel.Server.csproj"
                      AdditionalProperties="MarvelServerOutputType=Library" />
    <ProjectReference Include="../Marvel.View/Marvel.View.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Marvel.Godot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets/icons/card/*.svg"
                      LogicalName="Marvel.Godot.Assets.CardIcons.%(Filename).svg" />
    <EmbeddedResource Include="assets/art/*.svg"
                      LogicalName="Marvel.Godot.Assets.Art.%(Filename).svg" />
    <EmbeddedResource Include="assets/icons/resources/*.svg"
                      LogicalName="Marvel.Godot.Assets.Resources.%(Filename).svg" />
    <EmbeddedResource Include="assets/fonts/Barlow*.ttf"
                      LogicalName="Marvel.Godot.Assets.%(Filename).ttf" />
    <EmbeddedResource Include="assets/fonts/DejaVuSans.ttf"
                      LogicalName="Marvel.Godot.Assets.DejaVuSans.ttf" />
    <EmbeddedResource Include="assets/fonts/ChampionsIcons.ttf"
                      LogicalName="Marvel.Godot.Assets.ChampionsIcons.ttf" />
  </ItemGroup>

</Project>
