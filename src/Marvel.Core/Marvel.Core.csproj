<Project Sdk="Microsoft.NET.Sdk">

  <!-- The leaf assembly. No I/O, no UI framework, no ambient state.
       `Marvel.Core` is the one project name common to both layouts under
       review in MARVEL-159, so what lands here survives that decision. -->
  <PropertyGroup>
    <RootNamespace>Marvel.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The canonical string escaper is internal: it is a detail of how the
         digest is written, not something game code should reach for. The tests
         exercise it directly because it is the piece most likely to differ
         between languages, and a round-trip test alone would not distinguish
         "escapes correctly" from "escapes and unescapes symmetrically wrong". -->
    <InternalsVisibleTo Include="Marvel.Core.Tests" />
  </ItemGroup>

</Project>
