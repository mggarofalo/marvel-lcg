<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Marvel.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Marvel.Decisions/Marvel.Decisions.csproj" />
    <ProjectReference Include="../Marvel.Rules/Marvel.Rules.csproj" />
    <!-- The transport-neutral client embeds the host API, not its executable
         apphost and runtime configuration. -->
    <ProjectReference Include="../Marvel.Server/Marvel.Server.csproj"
                      AdditionalProperties="MarvelServerOutputType=Library" />
    <ProjectReference Include="../Marvel.View/Marvel.View.csproj" />
  </ItemGroup>

</Project>
