<Project Sdk="Microsoft.NET.Sdk">

  <!-- One engine host, usable in-process by Godot and as a standalone socket
       process. This is an I/O boundary; none of the projects it references
       know whether their caller is embedded or remote. -->
  <PropertyGroup>
    <OutputType Condition="'$(MarvelServerOutputType)' == ''">Exe</OutputType>
    <OutputType Condition="'$(MarvelServerOutputType)' != ''">$(MarvelServerOutputType)</OutputType>
    <OutputPath Condition="'$(MarvelServerOutputType)' == 'Library'">bin/embedded/$(Configuration)/</OutputPath>
    <IntermediateOutputPath Condition="'$(MarvelServerOutputType)' == 'Library'">obj/embedded/$(Configuration)/</IntermediateOutputPath>
    <RootNamespace>Marvel.Server</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Marvel.Decisions/Marvel.Decisions.csproj" />
    <ProjectReference Include="../Marvel.Cards/Marvel.Cards.csproj" />
    <ProjectReference Include="../Marvel.Content/Marvel.Content.csproj" />
    <ProjectReference Include="../Marvel.Session/Marvel.Session.csproj" />
    <ProjectReference Include="../Marvel.View/Marvel.View.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Marvel.Server.Tests" />
    <InternalsVisibleTo Include="Marvel.Godot.Tests" />
  </ItemGroup>

</Project>
