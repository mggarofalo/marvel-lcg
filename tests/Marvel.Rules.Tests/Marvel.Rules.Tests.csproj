<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Marvel.Rules.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Marvel.Rules/Marvel.Rules.csproj" />

    <!-- The Rules Reference harvester. Referenced so that the rules it reads
         the document by (how a heading becomes an id, how emphasis is written)
         are held against the 262 entries the document holds, rather than only
         against whatever page somebody last looked at. -->
    <ProjectReference Include="../../tools/Marvel.Rules.Harvest/Marvel.Rules.Harvest.csproj" />
    <ProjectReference Include="../../tools/Marvel.Rulings.Harvest/Marvel.Rulings.Harvest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- One copy, linked. See tests/Shared/RepositoryPaths.cs. -->
    <Compile Include="../Shared/RepositoryPaths.cs" Link="RepositoryPaths.cs" />
    <Compile Include="../Shared/DigestDiff.cs" Link="DigestDiff.cs" />
    <Compile Include="../Shared/Rule.cs" Link="Rule.cs" />
    <Compile Include="../Shared/RuleCitations.cs" Link="RuleCitations.cs" />

    <!-- One file, so one project holds it. See tests/Shared/RulesGraphTests.cs. -->
    <Compile Include="../Shared/RulesGraphTests.cs" Link="RulesGraphTests.cs" />
    <Compile Include="../Shared/Agendas.cs" Link="Agendas.cs" />

    <!-- The source reader is the report's behavior. Linking it makes the
         regression independent of whether the tool or the suite has built. -->
    <Compile Include="../../tools/Marvel.Rules.Index/Citations.cs" Link="Citations.cs" />
    <Compile Include="../../tools/Marvel.Rules.Index/Corpus.cs" Link="Corpus.cs" />
  </ItemGroup>

</Project>
