<Project>

  <!-- The dependency wall.

       docs/presentation-layer.md draws a line around the Godot implementation.
       Shared presentation lives below that framework boundary in `Marvel.View`,
       `Marvel.Decisions`, and `Marvel.Client`. The line is only worth drawing
       if the build refuses to cross it, so these targets run on every project
       and deny by default.

       Why it matters is determinism, not tidiness. AGENTS.md lists four things
       that must never enter a gameplay path, and Godot supplies three of them
       as conveniences: `Time`, `RandomNumberGenerator`, and the frame `delta`.
       An assembly that cannot see `GodotSharp` cannot reach any of them, which
       is what buys the presentation layer the freedom to use wall-clock time
       and unseeded randomness for animation — nothing it does can feed back
       into game state.

       Both gates are proven to fire, offline, by `tools/godot-wall.sh`. A gate
       nobody has watched fail is an assertion about a build, not a property of
       one. -->

  <PropertyGroup>
    <!-- Set to `true` in a .csproj to opt that project out. Only the Godot
         project and its own tests have any business doing so, and doing it is
         a deliberate, reviewable edit rather than something that happens by
         adding a package. -->
    <MarvelMayReferenceGodot Condition="'$(MarvelMayReferenceGodot)' == ''">false</MarvelMayReferenceGodot>

    <!-- These are normalized here, after each project has been evaluated. A
         project cannot appoint itself as the product client or a wall probe
         by copying a marker property into its own file. -->
    <MarvelGodotClientProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src/Marvel.Godot/Marvel.Godot.csproj'))</MarvelGodotClientProject>
    <MarvelGodotClientTestsProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests/Marvel.Godot.Tests/Marvel.Godot.Tests.csproj'))</MarvelGodotClientTestsProject>
    <MarvelGodotStubProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests/godot-wall/GodotSharp/GodotSharp.csproj'))</MarvelGodotStubProject>
    <MarvelGodotMiddleProbeProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests/godot-wall/Marvel.WallProbe.Middle/Marvel.WallProbe.Middle.csproj'))</MarvelGodotMiddleProbeProject>
    <MarvelGodotAllowedProbeProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests/godot-wall/Marvel.WallProbe.Allowed/Marvel.WallProbe.Allowed.csproj'))</MarvelGodotAllowedProbeProject>

    <!-- These exact paths opt the product projects into their ownership
         policies without relying on a marker that a project could remove.
         Throwaway probes set MarvelPresentationRole themselves. -->
    <MarvelViewProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src/Marvel.View/Marvel.View.csproj'))</MarvelViewProject>
    <MarvelDecisionsProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src/Marvel.Decisions/Marvel.Decisions.csproj'))</MarvelDecisionsProject>
    <MarvelClientProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src/Marvel.Client/Marvel.Client.csproj'))</MarvelClientProject>
    <MarvelPresentationRole Condition="'$(MSBuildProjectFullPath)' == '$(MarvelViewProject)'">View</MarvelPresentationRole>
    <MarvelPresentationRole Condition="'$(MSBuildProjectFullPath)' == '$(MarvelDecisionsProject)'">Decisions</MarvelPresentationRole>
    <MarvelPresentationRole Condition="'$(MSBuildProjectFullPath)' == '$(MarvelClientProject)'">Client</MarvelPresentationRole>
    <MarvelPresentationRole Condition="'$(MSBuildProjectFullPath)' == '$(MarvelGodotClientProject)'">Godot</MarvelPresentationRole>
  </PropertyGroup>

  <!-- An opt-out is part of the wall, not a way around it. The product's
       Godot assembly and its tests are the only ordinary projects allowed to
       set it. The throwaway wall probes identify themselves separately so the
       negative and positive cases remain offline and isolated from product
       code. -->
  <Target Name="MarvelGodotOptOut"
          BeforeTargets="ResolveReferences"
          Condition="'$(MarvelMayReferenceGodot)' == 'true' and
                     '$(MSBuildProjectFullPath)' != '$(MarvelGodotClientProject)' and
                     '$(MSBuildProjectFullPath)' != '$(MarvelGodotClientTestsProject)' and
                     '$(MSBuildProjectFullPath)' != '$(MarvelGodotStubProject)' and
                     '$(MSBuildProjectFullPath)' != '$(MarvelGodotMiddleProbeProject)' and
                     '$(MSBuildProjectFullPath)' != '$(MarvelGodotAllowedProbeProject)'">

    <Error Code="MARVELWALLOPT"
           Text="$(MSBuildProjectName) opts out of the Godot wall, but only the exact Godot presentation and wall-probe projects may do that. Remove MarvelMayReferenceGodot or add an explicit path to Directory.Build.targets with a firing probe." />
  </Target>

  <!-- Resolved references, not declared ones. `ReferencePath` is what the
       compiler will actually be handed after `ResolveReferences` has walked
       every ProjectReference, every PackageReference and their transitive
       closures — so a package three levels down that happens to depend on
       `GodotSharp` is caught, and so is a bare `<Reference Include>` pointing
       at a .dll on disk. Scanning the .csproj files would catch neither. -->
  <Target Name="MarvelGodotWall"
          AfterTargets="ResolveReferences"
          Condition="'$(MarvelMayReferenceGodot)' != 'true'">

    <ItemGroup>
      <MarvelGodotReference Include="@(ReferencePath)"
                            Condition="$([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('GodotSharp'))" />
    </ItemGroup>

    <Error Code="MARVELWALL"
           Condition="'@(MarvelGodotReference)' != ''"
           Text="$(MSBuildProjectName) resolves @(MarvelGodotReference->'%(Filename)', ', '). It sits below the wall, so it must not see Godot: see docs/presentation-layer.md. If this project genuinely is the presentation layer, set &lt;MarvelMayReferenceGodot&gt;true&lt;/MarvelMayReferenceGodot&gt; in its .csproj." />
  </Target>

  <!-- Presentation projects receive an allowlist rather than a denylist. This
       catches a direct engine ProjectReference before compilation. Disabling
       transitive project references in each product .csproj prevents an
       allowed reference such as Marvel.Server from making its own engine
       dependencies available to presentation source. -->
  <Target Name="MarvelPresentationWall"
          BeforeTargets="ResolveReferences"
          Condition="'$(MarvelPresentationRole)' != ''">

    <Error Code="MARVELPRESENTATIONCONFIG"
           Condition="'$(DisableTransitiveProjectReferences)' != 'true'"
           Text="$(MSBuildProjectName) has presentation role $(MarvelPresentationRole) but exposes transitive project references to its source. Set DisableTransitiveProjectReferences to true and add only the direct contracts this project uses." />

    <ItemGroup>
      <MarvelAllowedPresentationReference
          Include="$(MSBuildThisFileDirectory)src/Marvel.Rules/Marvel.Rules.csproj"
          Condition="'$(MarvelPresentationRole)' == 'View' or '$(MarvelPresentationRole)' == 'Decisions' or '$(MarvelPresentationRole)' == 'Client' or '$(MarvelPresentationRole)' == 'Godot'" />
      <MarvelAllowedPresentationReference
          Include="$(MSBuildThisFileDirectory)src/Marvel.Decisions/Marvel.Decisions.csproj"
          Condition="'$(MarvelPresentationRole)' == 'Client' or '$(MarvelPresentationRole)' == 'Godot'" />
      <MarvelAllowedPresentationReference
          Include="$(MSBuildThisFileDirectory)src/Marvel.Server/Marvel.Server.csproj"
          Condition="'$(MarvelPresentationRole)' == 'Client' or '$(MarvelPresentationRole)' == 'Godot'" />
      <MarvelAllowedPresentationReference
          Include="$(MSBuildThisFileDirectory)src/Marvel.View/Marvel.View.csproj"
          Condition="'$(MarvelPresentationRole)' == 'Client' or '$(MarvelPresentationRole)' == 'Godot'" />
      <MarvelAllowedPresentationReference
          Include="$(MSBuildThisFileDirectory)src/Marvel.Client/Marvel.Client.csproj"
          Condition="'$(MarvelPresentationRole)' == 'Godot'" />

      <MarvelUnexpectedPresentationReference Include="@(ProjectReference)" />
      <MarvelUnexpectedPresentationReference
          Remove="@(MarvelAllowedPresentationReference)"
          MatchOnMetadata="FullPath"
          MatchOnMetadataOptions="PathLike" />
    </ItemGroup>

    <Error Code="MARVELPRESENTATION"
           Condition="'@(MarvelUnexpectedPresentationReference)' != ''"
           Text="$(MSBuildProjectName) has presentation role $(MarvelPresentationRole) and may not reference @(MarvelUnexpectedPresentationReference->'%(Filename)', ', '). Put authoritative behavior in the engine and expose a prompt, event, descriptor, or engine-owned legality function: see docs/presentation-layer.md." />
  </Target>

  <!-- The runtime floor.

       `GodotSharp` 4.7.0 ships net8.0, and a net8.0 project cannot reference a
       net10.0 library, so every assembly below the wall sits at or below
       Godot's floor. The failure this guards against is not subtle reasoning
       about framework compatibility — it is someone creating a new project
       next year, taking whatever TFM the SDK offers by default, and finding
       out at the point Godot tries to reference it. -->
  <Target Name="MarvelRuntimeFloor"
          BeforeTargets="CoreCompile"
          Condition="'$(TargetFramework)' != '' and '$(MarvelTargetFrameworkOverride)' != 'true'">

    <Error Code="MARVELTFM"
           Condition="'$(TargetFramework)' != '$(MarvelTargetFramework)'"
           Text="$(MSBuildProjectName) targets $(TargetFramework), but the solution's floor is $(MarvelTargetFramework) and Godot cannot reference anything above it (Directory.Build.props). Do not raise this one project; raise the floor, or set &lt;MarvelTargetFrameworkOverride&gt;true&lt;/MarvelTargetFrameworkOverride&gt; if this assembly is genuinely never consumed by Godot." />
  </Target>

</Project>
