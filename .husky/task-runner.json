{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "source-layout",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".husky/csx/source-layout.csx"
      ]
    },
    {
      "name": "cyclomatic-complexity",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".husky/csx/complexity.csx"
      ]
    },
    {
      "name": "file-length",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".husky/csx/file-length.csx"
      ]
    },
    {
      "name": "release-build",
      "group": "validation",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".husky/csx/release-build.csx"
      ]
    },
    {
      "name": "all-tests",
      "group": "validation",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".husky/csx/all-tests.csx"
      ]
    },
    {
      "name": "native-smoke",
      "group": "validation",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".husky/csx/native-smoke.csx"
      ]
    }
  ]
}
