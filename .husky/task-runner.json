{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "cyclomatic-complexity",
      "group": "pre-commit",
      "command": "lizard",
      "args": [
        "--CCN",
        "10",
        "--warnings_only",
        "${staged}"
      ],
      "include": [
        "src/**/*.cs",
        "src/**/*.gd",
        "tests/**/*.cs",
        "tools/**/*.cs"
      ],
      "filteringRule": "staged"
    },
    {
      "name": "file-length",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "husky",
        "exec",
        ".husky/csx/file-length.csx",
        "--args",
        "${staged}"
      ],
      "include": [
        "**/*.cs",
        "**/*.csx",
        "**/*.gd",
        "**/*.ps1",
        "**/*.sh"
      ],
      "exclude": [
        "datasets/**/*"
      ],
      "filteringRule": "staged"
    },
    {
      "name": "unit-tests",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "test",
        "tests/Marvel.UnitTests.slnx",
        "--configuration",
        "Release",
        "--nologo"
      ]
    }
  ]
}
