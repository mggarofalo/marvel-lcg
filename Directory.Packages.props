<Project>

  <!-- Central package management: versions live here, never in a .csproj.
       A solution validated against pinned cross-language fixtures should not
       be able to acquire two versions of the same dependency by accident. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- The Gherkin parser Reqnroll is built on. Referenced directly rather
         than through Reqnroll itself: MARVEL-41 asks whether the spec *format*
         is compatible, and that is a parsing question. Pulling in the full
         BDD runner would also require step definitions for an engine that does
         not exist yet. -->
    <PackageVersion Include="Gherkin" Version="34.0.0" />

    <!-- Reads the Rules Reference PDF, for `tools/Marvel.Rules.Harvest`. Not
         an engine dependency and not on any path a game takes: the harvester
         is run by hand when a new Rules Reference ships, against a PDF this
         repository does not hold and cannot hold. -->
    <PackageVersion Include="PdfPig" Version="0.1.11" />
  </ItemGroup>

</Project>
