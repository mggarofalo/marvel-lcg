<Project>

  <!-- Settings every project inherits. Kept here rather than repeated per
       .csproj so that "what is this solution's C# dialect" has one answer. -->
  <PropertyGroup>
    <!-- net8.0, not net10.0, and this is a hard external constraint rather
         than conservatism: `GodotSharp` 4.7.0 ships `net8.0`, so a Godot C#
         project targets `net8.0`, and a `net8.0` project cannot reference a
         `net10.0` library. Godot is the presentation layer, so
         every assembly it consumes has to sit at or below its floor.

         Targeting .NET 10 from Godot is not an available alternative today:
         it is not the default, and godotengine/godot#112701 reports the
         managed host failing to probe shared-framework assemblies under it.

         The cost is one API call: see `StateDigest.Sha256`.

         Named as well as set, because `Directory.Build.targets` gates on it:
         a project that quietly overrides `TargetFramework` fails the build
         rather than discovering the incompatibility when Godot first tries to
         reference it. -->
    <MarvelTargetFramework>net8.0</MarvelTargetFramework>
    <TargetFramework>$(MarvelTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning nobody has to fix is a warning nobody reads. This engine is
         validated byte-for-byte against another implementation, so the class
         of bug the compiler can catch is exactly the class that is most
         expensive to find later. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Deterministic builds: the same source must produce the same assembly.
         The whole project rests on reproducibility (docs/rng-contract.md,
         docs/state-digest-contract.md); the build should not be the one part
         that drifts. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Invariant globalization: culture must never reach a comparison or a
         number format. A digest that differs between a machine set to
         tr-TR and one set to en-US is not a digest. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
